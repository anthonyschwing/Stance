{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["*.html", "*.css", "*.js", "*.jsx", "*.png", "assets/**/*"],
        "maxDuration": 60
      }
    },
    {
      "src": "api/ask.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "rag/**",
        "maxDuration": 30
      }
    }
  ],
  "routes": [
    { "src": "/api/rag-ask", "dest": "api/ask.py" },
    { "src": "/(.*)", "dest": "server.js" }
  ],
  "crons": [
    { "path": "/api/snapshot-stability", "schedule": "0 6 * * *" }
  ]
}
