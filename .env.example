# ─── Airtable ─────────────────────────────────────────────
# Trouvez ces valeurs dans : airtable.com/account (API key)
# et dans l'URL de votre base (appXXXXXXXXXXXXXX)

AIRTABLE_API_KEY=patXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Noms exacts des tables dans votre base Airtable
AIRTABLE_EMPLOYEE_TABLE=Employee Analytics
AIRTABLE_DEPARTMENT_TABLE=Department_rollups
AIRTABLE_EXECUTIVE_TABLE=Executive_Summaries

# ─── Make webhook (CSV Upload only — Ask Stance now uses rag/, see below) ──
MAKE_CSV_WEBHOOK_URL=https://hook.eu2.make.com/XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Serveur ──────────────────────────────────────────────
PORT=3000

# ─── Workforce Stability history (cron snapshot) ──────────
# Créez manuellement une table Airtable "Workforce_Stability_Snapshots"
# avec les champs : Date (texte, format YYYY-MM-DD), Total (nombre),
# AttritionRate (nombre), RetentionRate (nombre), AvgRisk (nombre),
# CriticalCount (nombre), HighCount (nombre) — ces deux derniers alimentent
# la tendance "at-risk" de Cockpit ; les snapshots antérieurs à leur ajout
# restent valides (le champ est simplement absent, le frontend l'ignore).
AIRTABLE_STABILITY_TABLE=Workforce_Stability_Snapshots

# Secret partagé avec Vercel Cron pour authentifier l'appel à
# /api/snapshot-stability. Générez une valeur aléatoire (ex: openssl rand -hex 32)
# et ajoutez-la aussi dans Project Settings → Environment Variables sur Vercel.
CRON_SECRET=

# ─── Cockpit (espace décideur — voir /cockpit) ─────────────
# Créez manuellement une table Airtable "Turnover_Cost_Assumptions" avec les
# champs : "Avg Replacement Cost Ratio" (nombre, ex 0.5 pour 50% du salaire
# annuel) et "Effective Date" (date). Un seul enregistrement suffit en V1 —
# c'est le plus récent (tri par Effective Date desc) qui est utilisé.
# Tant que la table n'existe pas, le serveur retombe sur 50% par défaut.
AIRTABLE_TURNOVER_COST_TABLE=Turnover_Cost_Assumptions

# Créez manuellement une table Airtable "Cockpit_Briefings" avec les champs :
# Date (texte, YYYY-MM-DD), Synthesis (texte long), Overall_Signal (texte),
# Turnover_Cost_Estimate (nombre), Generated_At (date/heure). Alimentée
# automatiquement par /api/cockpit/briefing (un appel Claude par jour,
# mis en cache dans cette table) — distincte d'Executive_Summaries, qui
# reste dédiée au message CEO de la landing page côté Sentinelle.
AIRTABLE_COCKPIT_BRIEFING_TABLE=Cockpit_Briefings

# ─── Import client (mapping de colonnes intelligent) ───────────────────
# Créez manuellement une table Airtable "Client_Field_Mappings" avec les
# champs : Client (texte), Internal_Field (single select — voir field-schema.js
# pour la liste), Source_Column (texte), Sample_Value (texte), Confidence
# (nombre), Status (single select : Suggested/Confirmed/Rejected/Unmapped),
# Confirmed_At (date), Source_File (texte). Une ligne par (Client, Internal_Field).
# Tant que la table n'existe pas, chaque import repropose le mapping à Claude
# sans planter — juste sans mémoire d'un import à l'autre.
AIRTABLE_MAPPING_TABLE=Client_Field_Mappings

# ─── Ask Stance RAG pipeline (Python module rag/, exposed via api/ask.py) ──
# Clé API Claude — console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ANTHROPIC_MODEL=claude-sonnet-5

# Optionnel — réglages fins du chunking / de la collection Chroma
RAG_CHROMA_COLLECTION=stance_hr_data
RAG_CHUNK_MAX_CHARS=1000
RAG_CHUNK_OVERLAP_CHARS=150

# Optionnel, dev local uniquement — surcharge l'URL que server.js appelle pour
# /api/ask (par défaut il appelle son propre domaine + /api/rag-ask, ce qui ne
# marche qu'une fois déployé sur Vercel ou sous `vercel dev`).
RAG_API_URL=
